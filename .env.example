# Copy this file to .env locally and fill in your public client-side contact form configuration.
REACT_APP_SERVICE_ID=
REACT_APP_TEMPLATE_ID=
REACT_APP_PUBLIC_KEY=
# Required for the contact form. Use a reCAPTCHA site key that allows your local dev host
# (localhost) and configure the production key in the production build environment.
REACT_APP_RECAPTCHA_SITE_KEY=
