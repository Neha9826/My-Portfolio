# Copy to .env.local and replace each placeholder with your own configuration.
# These are browser-side identifiers/public keys, not private server secrets.
REACT_APP_SERVICE_ID=your_emailjs_service_id
REACT_APP_TEMPLATE_ID=your_emailjs_template_id
REACT_APP_PUBLIC_KEY=your_emailjs_public_key
REACT_APP_RECAPTCHA_SITE_KEY=your_recaptcha_v2_site_key

SKIP_PREFLIGHT_CHECK=true
